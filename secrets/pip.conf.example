# Modele du secret de build pip_config.
# Copier en secrets/pip.conf (ignore par git et exclu du contexte de build),
# puis remplacer l'URL par celle du depot prive avec son jeton, par exemple :
#   index-url = https://__token__:<JETON>@pypi.entreprise.local/simple
[global]
index-url = https://pypi.org/simple
